# Browser build. Set this in Cloudflare Pages build variables to enable Account & sync.
VITE_API_ENABLED=true

# Office server only. Never use a VITE_ prefix for a secret.
APP_ORIGIN=https://wilderness-almanac.example.com
DATABASE_VOLUME=wilderness_almanac_data
DATABASE_PATH=/data/wilderness-almanac.sqlite
BETTER_AUTH_SECRET=
API_PROXY_SECRET=
RESEND_API_KEY=
RESEND_FROM=Wilderness Almanac <login@example.com>

# A private bucket outside the office server. Cloudflare R2 is S3-compatible.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BACKUP_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=auto
BACKUP_PREFIX=wilderness-almanac
BACKUP_INTERVAL_HOURS=6

# Set API_ORIGIN and the same API_PROXY_SECRET in Cloudflare Pages runtime variables,
# not in the browser bundle:
# API_ORIGIN=https://wilderness-almanac-api.example.com
