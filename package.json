{
  "name": "hex-sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A DM toolbox for sandbox RPG campaigns with editable isometric hex maps.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "three": "0.160.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
