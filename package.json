{
  "name": "wilderness-almanac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A DM toolbox for sandbox RPG campaigns with editable isometric hex maps.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "typecheck:incremental": "tsc -p tsconfig.incremental.json",
    "test": "node --test tests/*.test.js",
    "test:server": "npm test --prefix server",
    "test:account": "playwright test --config=playwright.account.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:storage": "playwright test --config=playwright.storage.config.js",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm run test:e2e",
    "test:workspace": "playwright test --config=playwright.workspace.config.js"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.160.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
